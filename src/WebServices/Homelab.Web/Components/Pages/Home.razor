@page "/"

<PageTitle>Homelab</PageTitle>

<section class="home-hero mb-5">
    <div class="row align-items-center g-4">
        <div class="col-lg-7">
            <p class="text-uppercase text-body-secondary small fw-semibold mb-2">Online learning environment</p>
            <h1 class="display-5 fw-semibold mb-3">Homelab brings your study program together.</h1>
            <p class="lead text-body-secondary mb-4">
                Access session content, assignments, exam preparation, study information, and communication with your lecturer and fellow students in one clear academic workspace.
            </p>
            <div class="d-flex flex-wrap gap-2">
                <a class="btn btn-primary btn-lg" href="modules">View modules</a>
                <a class="btn btn-outline-primary btn-lg" href="Account/Manage">Manage profile</a>
            </div>
        </div>
        <div class="col-lg-5">
            <div class="border rounded p-4 home-summary">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <span class="text-body-secondary small">Student workspace</span>
                    <span class="badge text-bg-warning">Current</span>
                </div>
                <div class="vstack gap-3">
                    <div>
                        <div class="fw-semibold">Upcoming meetings</div>
                        <div class="small text-body-secondary">Lectures, labs, workshops, and exams in chronological order.</div>
                    </div>
                    <div>
                        <div class="fw-semibold">Preparation tasks</div>
                        <div class="small text-body-secondary">Assignments, practice exercises, readings, and useful links.</div>
                    </div>
                    <div>
                        <div class="fw-semibold">Academic communication</div>
                        <div class="small text-body-secondary">Questions, announcements, discussion topics, and lecturer updates.</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="row g-3 mb-5">
    <div class="col-md-4">
        <div class="border rounded p-4 h-100">
            <h2 class="h5">Learn with structure</h2>
            <p class="text-body-secondary mb-0">
                Each module can collect learning objectives, activities, lesson content, background information, videos, tests, and resources for every session.
            </p>
        </div>
    </div>
    <div class="col-md-4">
        <div class="border rounded p-4 h-100">
            <h2 class="h5">Stay informed</h2>
            <p class="text-body-secondary mb-0">
                Students can find module dates, teacher details, exam information, downloads, regulations, and profile information whenever they need it.
            </p>
        </div>
    </div>
    <div class="col-md-4">
        <div class="border rounded p-4 h-100">
            <h2 class="h5">Connect beyond class</h2>
            <p class="text-body-secondary mb-0">
                Homelab supports questions, announcements, discussion topics, supplementary materials, and practical updates from lecturers and staff.
            </p>
        </div>
    </div>
</section>

<section class="border rounded p-4">
    <div class="row align-items-center g-3">
        <div class="col-lg-8">
            <h2 class="h4 mb-2">A personal academic file, always current.</h2>
            <p class="text-body-secondary mb-0">
                Homelab is also designed to keep student details, study progress, attendance, results, and change requests organized so students and the institution work from the same up-to-date information.
            </p>
        </div>
        <div class="col-lg-4 text-lg-end">
            <a class="btn btn-outline-primary" href="modules">Open learning overview</a>
        </div>
    </div>
</section>

<style>
    .home-hero {
        padding: 2.5rem;
        border: 1px solid #2c3a4a;
        border-radius: .75rem;
        background:
            linear-gradient(135deg, rgba(217, 183, 111, .12), rgba(49, 95, 136, .10)),
            #121c27;
    }

    .home-summary {
        background-color: rgba(15, 23, 32, .58);
    }
</style>
