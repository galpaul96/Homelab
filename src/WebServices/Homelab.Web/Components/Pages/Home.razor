@page "/"

<PageTitle>Homelab</PageTitle>

<section class="home-hero mb-5">
    <div class="row align-items-center g-4">
        <div class="col-lg-7">
            <p class="text-uppercase text-body-secondary small fw-semibold mb-2">Operations workspace</p>
            <h1 class="display-5 fw-semibold mb-3">Homelab keeps internal tools close at hand.</h1>
            <p class="lead text-body-secondary mb-4">
                Manage platform configuration, notifications, identity, and licensing clients from one clear workspace.
            </p>
            <div class="d-flex flex-wrap gap-2">
                <a class="btn btn-primary btn-lg" href="licensing">Open licensing</a>
                <a class="btn btn-outline-primary btn-lg" href="Account/Manage">Manage profile</a>
            </div>
        </div>
        <div class="col-lg-5">
            <div class="border rounded p-4 home-summary">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <span class="text-body-secondary small">Admin workspace</span>
                    <span class="badge text-bg-warning">Current</span>
                </div>
                <div class="vstack gap-3">
                    <div>
                        <div class="fw-semibold">Client catalog</div>
                        <div class="small text-body-secondary">Track external entities with descriptions and operational notes.</div>
                    </div>
                    <div>
                        <div class="fw-semibold">Focused details</div>
                        <div class="small text-body-secondary">Open each client record and maintain the editable context that matters.</div>
                    </div>
                    <div>
                        <div class="fw-semibold">Identity and notifications</div>
                        <div class="small text-body-secondary">Manage users, roles, claims, and application messages.</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="row g-3 mb-5">
    <div class="col-md-4">
        <div class="border rounded p-4 h-100">
            <h2 class="h5">Manage clients</h2>
            <p class="text-body-secondary mb-0">
                Create and browse external client entities from a compact Admin-only catalog.
            </p>
        </div>
    </div>
    <div class="col-md-4">
        <div class="border rounded p-4 h-100">
            <h2 class="h5">Maintain context</h2>
            <p class="text-body-secondary mb-0">
                Keep descriptions and notes current without exposing persistence models to the web surface.
            </p>
        </div>
    </div>
    <div class="col-md-4">
        <div class="border rounded p-4 h-100">
            <h2 class="h5">Control access</h2>
            <p class="text-body-secondary mb-0">
                Licensing pages remain available only to authenticated users with the Admin role.
            </p>
        </div>
    </div>
</section>

<section class="border rounded p-4">
    <div class="row align-items-center g-3">
        <div class="col-lg-8">
            <h2 class="h4 mb-2">A compact admin surface for the homelab.</h2>
            <p class="text-body-secondary mb-0">
                The web app talks to API services through typed client services, keeping UI code separate from persistence and service internals.
            </p>
        </div>
        <div class="col-lg-4 text-lg-end">
            <a class="btn btn-outline-primary" href="licensing">Open licensing</a>
        </div>
    </div>
</section>

<style>
    .home-hero {
        padding: 2.5rem;
        border: 1px solid #2c3a4a;
        border-radius: .75rem;
        background:
            linear-gradient(135deg, rgba(217, 183, 111, .12), rgba(49, 95, 136, .10)),
            #121c27;
    }

    .home-summary {
        background-color: rgba(15, 23, 32, .58);
    }
</style>
