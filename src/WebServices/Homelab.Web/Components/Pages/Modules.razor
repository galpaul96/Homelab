@page "/modules"
@rendermode InteractiveServer
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@using Homelab.Web.Services
@inject IModulesService modulesService

<PageTitle>Modules</PageTitle>

<div class="d-flex align-items-center justify-content-between gap-3 mb-4">
    <div>
        <h1 class="mb-1">Modules</h1>
        <div class="text-body-secondary">Upcoming lectures, labs, exams, and assignments</div>
    </div>
    <button type="button" class="btn btn-outline-primary" @onclick="LoadEventsAsync" disabled="@isLoading">
        @if (isLoading)
        {
            <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>
        }
        Refresh
    </button>
</div>

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="alert alert-danger" role="alert">
        @errorMessage
    </div>
}

@if (events is null)
{
    <div class="d-flex align-items-center gap-2 text-body-secondary">
        <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
        <span>Loading modules...</span>
    </div>
}
else if (events.Count == 0)
{
    <div class="alert alert-info" role="alert">
        No upcoming module events were found.
    </div>
}
else
{
    <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-3">
        @foreach (var item in events)
        {
            <div class="col">
                <button type="button" class="card h-100 w-100 text-start shadow-sm border-0 module-card" @onclick="() => OpenEventAsync(item)">
                    <div class="card-body d-flex flex-column gap-3">
                        <div class="d-flex justify-content-between align-items-start gap-2">
                            <span class="badge rounded-pill @GetBadgeClass(item.EventType)">@GetEventTypeLabel(item)</span>
                            <span class="small text-body-secondary text-nowrap">@item.StartsAt.ToString("MMM d")</span>
                        </div>

                        <div>
                            <h2 class="h5 card-title mb-2">@item.Title</h2>
                            <div class="text-body-secondary small">@item.ModuleCode @item.ModuleName</div>
                        </div>

                        <dl class="row small mb-0 g-2 mt-auto">
                            <dt class="col-4 text-body-secondary fw-normal">When</dt>
                            <dd class="col-8 mb-0">@FormatDateTimeRange(item)</dd>

                            @if (!string.IsNullOrWhiteSpace(item.TeacherName))
                            {
                                <dt class="col-4 text-body-secondary fw-normal">Teacher</dt>
                                <dd class="col-8 mb-0">@item.TeacherName</dd>
                            }

                            @if (!string.IsNullOrWhiteSpace(item.LocationName))
                            {
                                <dt class="col-4 text-body-secondary fw-normal">Where</dt>
                                <dd class="col-8 mb-0">@item.LocationName</dd>
                            }

                            @if (item.RelatedItemCount > 0)
                            {
                                <dt class="col-4 text-body-secondary fw-normal">Prep</dt>
                                <dd class="col-8 mb-0">@item.RelatedItemCount item@(item.RelatedItemCount == 1 ? string.Empty : "s")</dd>
                            }
                        </dl>
                    </div>
                </button>
            </div>
        }
    </div>
}

@if (selectedEvent is not null)
{
    <div class="modal fade show d-block" tabindex="-1" role="dialog" aria-modal="true">
        <div class="modal-dialog modal-xl modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    <div>
                        <span class="badge rounded-pill @GetBadgeClass(selectedEvent.EventType) mb-2">@GetEventTypeLabel(selectedEvent)</span>
                        <h2 class="modal-title h4">@selectedEvent.Title</h2>
                    </div>
                    <button type="button" class="btn-close" aria-label="Close" @onclick="CloseModal"></button>
                </div>

                <div class="modal-body">
                    @if (isLoadingDetail)
                    {
                        <div class="d-flex align-items-center gap-2 text-body-secondary">
                            <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
                            <span>Loading details...</span>
                        </div>
                    }
                    else
                    {
                        <div class="row g-4">
                            <div class="col-lg-4">
                                <div class="list-group list-group-flush border rounded">
                                    <div class="list-group-item">
                                        <div class="small text-body-secondary">Module</div>
                                        <div class="fw-semibold">@selectedEvent.ModuleCode @selectedEvent.ModuleName</div>
                                    </div>
                                    <div class="list-group-item">
                                        <div class="small text-body-secondary">When</div>
                                        <div class="fw-semibold">@FormatDateTimeRange(selectedEvent)</div>
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(selectedEvent.TeacherName))
                                    {
                                        <div class="list-group-item">
                                            <div class="small text-body-secondary">Teacher</div>
                                            <div class="fw-semibold">@selectedEvent.TeacherName</div>
                                            <div class="small text-body-secondary">@selectedEvent.TeacherEmail</div>
                                        </div>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(selectedEvent.LocationName) || !string.IsNullOrWhiteSpace(selectedEvent.OnlineUrl))
                                    {
                                        <div class="list-group-item">
                                            <div class="small text-body-secondary">Location</div>
                                            <div class="fw-semibold">@selectedEvent.LocationName</div>
                                            <div class="small text-body-secondary">@selectedEvent.LocationAddress</div>
                                            @if (!string.IsNullOrWhiteSpace(selectedEvent.OnlineUrl))
                                            {
                                                <a class="small" href="@selectedEvent.OnlineUrl" target="_blank" rel="noopener noreferrer">Open online room</a>
                                            }
                                        </div>
                                    }
                                    @if (selectedEvent.AttendanceStatus.HasValue)
                                    {
                                        <div class="list-group-item">
                                            <div class="small text-body-secondary">Attendance</div>
                                            <div class="fw-semibold">@selectedEvent.AttendanceStatus</div>
                                        </div>
                                    }
                                </div>
                            </div>

                            <div class="col-lg-8">
                                @if (!string.IsNullOrWhiteSpace(selectedEvent.Description))
                                {
                                    <section class="mb-4">
                                        <h3 class="h6 text-uppercase text-body-secondary">Summary</h3>
                                        <p class="mb-0">@selectedEvent.Description</p>
                                    </section>
                                }

                                @if (selectedMeeting is null)
                                {
                                    <section class="mb-4">
                                        <h3 class="h6 text-uppercase text-body-secondary">Assessment</h3>
                                        <div class="row g-3">
                                            @if (selectedEvent.AssignmentStatus.HasValue)
                                            {
                                                <div class="col-sm-6">
                                                    <div class="border rounded p-3 h-100">
                                                        <div class="small text-body-secondary">Status</div>
                                                        <div class="fw-semibold">@selectedEvent.AssignmentStatus</div>
                                                    </div>
                                                </div>
                                            }
                                            @if (selectedEvent.MaximumScore.HasValue)
                                            {
                                                <div class="col-sm-6">
                                                    <div class="border rounded p-3 h-100">
                                                        <div class="small text-body-secondary">Score / passing score</div>
                                                        <div class="fw-semibold">@selectedEvent.MaximumScore</div>
                                                    </div>
                                                </div>
                                            }
                                            @if (selectedEvent.WeightPercentage.HasValue)
                                            {
                                                <div class="col-sm-6">
                                                    <div class="border rounded p-3 h-100">
                                                        <div class="small text-body-secondary">Weight</div>
                                                        <div class="fw-semibold">@selectedEvent.WeightPercentage%</div>
                                                    </div>
                                                </div>
                                            }
                                            @if (selectedEvent.ResultScore.HasValue || !string.IsNullOrWhiteSpace(selectedEvent.ResultGrade))
                                            {
                                                <div class="col-sm-6">
                                                    <div class="border rounded p-3 h-100">
                                                        <div class="small text-body-secondary">Result</div>
                                                        <div class="fw-semibold">@selectedEvent.ResultGrade @selectedEvent.ResultScore</div>
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    </section>
                                }
                                else
                                {
                                    @if (!string.IsNullOrWhiteSpace(selectedMeeting.PreparationInstructions))
                                    {
                                        <section class="mb-4">
                                            <h3 class="h6 text-uppercase text-body-secondary">Preparation</h3>
                                            <p class="mb-0">@selectedMeeting.PreparationInstructions</p>
                                        </section>
                                    }

                                    <div class="accordion" id="meetingDetailAccordion">
                                        @RenderAccordionSection("objectives", "Learning objectives", selectedMeeting.LearningObjectives.Count, @<div class="vstack gap-2">
                                            @foreach (var objective in selectedMeeting.LearningObjectives)
                                            {
                                                <div class="border rounded p-3">
                                                    <div class="fw-semibold">@objective.Title</div>
                                                    <div class="text-body-secondary small">@objective.Description</div>
                                                    @if (!string.IsNullOrWhiteSpace(objective.BloomLevel))
                                                    {
                                                        <span class="badge text-bg-light mt-2">@objective.BloomLevel</span>
                                                    }
                                                </div>
                                            }
                                        </div>)

                                        @RenderAccordionSection("activities", "Learning activities", selectedMeeting.LearningActivities.Count, @<div class="vstack gap-2">
                                            @foreach (var activity in selectedMeeting.LearningActivities)
                                            {
                                                <div class="border rounded p-3">
                                                    <div class="d-flex justify-content-between gap-2">
                                                        <div class="fw-semibold">@activity.Title</div>
                                                        <span class="small text-body-secondary">@activity.DurationMinutes min</span>
                                                    </div>
                                                    <div class="text-body-secondary small">@activity.Description</div>
                                                    @if (!string.IsNullOrWhiteSpace(activity.Instructions))
                                                    {
                                                        <div class="small mt-2">@activity.Instructions</div>
                                                    }
                                                </div>
                                            }
                                        </div>)

                                        @RenderAccordionSection("assignments", "Preparation assignments", selectedMeeting.PreparationAssignments.Count, @<div class="vstack gap-2">
                                            @foreach (var assignment in selectedMeeting.PreparationAssignments)
                                            {
                                                <div class="border rounded p-3">
                                                    <div class="fw-semibold">@assignment.Title</div>
                                                    <div class="small text-body-secondary">Due @assignment.DueAt?.ToString("MMM d, yyyy HH:mm")</div>
                                                    <div class="small">Score @assignment.MaximumScore | Weight @assignment.WeightPercentage%</div>
                                                </div>
                                            }
                                        </div>)

                                        @RenderAccordionSection("resources", "Resources", selectedMeeting.Resources.Count, @<div class="vstack gap-2">
                                            @foreach (var resource in selectedMeeting.Resources)
                                            {
                                                <div class="border rounded p-3">
                                                    <div class="fw-semibold">@resource.Title</div>
                                                    <div class="text-body-secondary small">@resource.Description</div>
                                                    @if (!string.IsNullOrWhiteSpace(resource.CitationText))
                                                    {
                                                        <div class="small mt-2">@resource.CitationText</div>
                                                    }
                                                    @if (!string.IsNullOrWhiteSpace(resource.Url))
                                                    {
                                                        <a class="small" href="@resource.Url" target="_blank" rel="noopener noreferrer">Open resource</a>
                                                    }
                                                </div>
                                            }
                                        </div>)

                                        @RenderAccordionSection("lessons", "Lesson content", selectedMeeting.LessonContents.Count, @<div class="vstack gap-2">
                                            @foreach (var lesson in selectedMeeting.LessonContents)
                                            {
                                                <div class="border rounded p-3">
                                                    <div class="fw-semibold">@lesson.Title</div>
                                                    <div class="text-body-secondary small">@lesson.Summary</div>
                                                    @if (lesson.EstimatedStudyMinutes.HasValue)
                                                    {
                                                        <span class="badge text-bg-light mt-2">@lesson.EstimatedStudyMinutes min</span>
                                                    }
                                                </div>
                                            }
                                        </div>)

                                        @RenderAccordionSection("tips", "Study tips", selectedMeeting.StudyTips.Count, @<div class="vstack gap-2">
                                            @foreach (var tip in selectedMeeting.StudyTips)
                                            {
                                                <div class="border rounded p-3">
                                                    <div class="fw-semibold">@tip.Title</div>
                                                    <div class="text-body-secondary small">@tip.Body</div>
                                                </div>
                                            }
                                        </div>)

                                        @RenderAccordionSection("directions", "Directions", selectedMeeting.Directions.Count, @<div class="vstack gap-2">
                                            @foreach (var direction in selectedMeeting.Directions)
                                            {
                                                <div class="border rounded p-3">
                                                    <div class="fw-semibold">@direction.Title</div>
                                                    <div class="text-body-secondary small">@direction.Instructions</div>
                                                    @if (!string.IsNullOrWhiteSpace(direction.ParkingInstructions))
                                                    {
                                                        <div class="small mt-2">@direction.ParkingInstructions</div>
                                                    }
                                                </div>
                                            }
                                        </div>)
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade show"></div>
}

<style>
    .module-card {
        cursor: pointer;
        transition: transform .15s ease, box-shadow .15s ease;
    }

    .module-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 .75rem 1.5rem rgba(0, 0, 0, .12) !important;
    }
</style>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    private Guid? studentId;
    private IReadOnlyList<StudentUpcomingEventModel>? events;
    private StudentUpcomingEventModel? selectedEvent;
    private StudentMeetingDetailModel? selectedMeeting;
    private bool isLoading;
    private bool isLoadingDetail;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        studentId = await GetCurrentStudentIdAsync();

        if (!studentId.HasValue)
        {
            errorMessage = "Unable to determine the current student id from the signed-in user.";
            events = [];
            return;
        }

        await LoadEventsAsync();
    }

    private async Task LoadEventsAsync()
    {
        if (!studentId.HasValue)
        {
            errorMessage = "Unable to determine the current student id from the signed-in user.";
            events = [];
            return;
        }

        isLoading = true;
        errorMessage = null;

        try
        {
            events = await modulesService.GetUpcomingEventsAsync(studentId.Value);
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
            events = [];
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task OpenEventAsync(StudentUpcomingEventModel item)
    {
        if (!studentId.HasValue)
        {
            errorMessage = "Unable to determine the current student id from the signed-in user.";
            return;
        }

        selectedEvent = item;
        selectedMeeting = null;

        if (item.EventType != StudentUpcomingEventType.Meeting)
        {
            return;
        }

        isLoadingDetail = true;

        try
        {
            selectedMeeting = await modulesService.GetMeetingAsync(studentId.Value, item.Id);
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isLoadingDetail = false;
        }
    }

    private async Task<Guid?> GetCurrentStudentIdAsync()
    {
        if (AuthenticationStateTask is null)
        {
            return null;
        }

        var authenticationState = await AuthenticationStateTask;
        var userId = authenticationState.User.FindFirstValue(ClaimTypes.NameIdentifier);

        return Guid.TryParse(userId, out var parsedUserId) ? parsedUserId : null;
    }

    private void CloseModal()
    {
        selectedEvent = null;
        selectedMeeting = null;
        isLoadingDetail = false;
    }

    private static string GetEventTypeLabel(StudentUpcomingEventModel item)
    {
        return item.EventType switch
        {
            StudentUpcomingEventType.Meeting when item.MeetingFormat.HasValue => item.MeetingFormat.Value.ToString(),
            _ => item.EventType.ToString()
        };
    }

    private static string GetBadgeClass(StudentUpcomingEventType eventType)
    {
        return eventType switch
        {
            StudentUpcomingEventType.Meeting => "text-bg-primary",
            StudentUpcomingEventType.Assignment => "text-bg-warning",
            StudentUpcomingEventType.Exam => "text-bg-danger",
            _ => "text-bg-secondary"
        };
    }

    private static string FormatDateTimeRange(StudentUpcomingEventModel item)
    {
        if (!item.EndsAt.HasValue || item.EndsAt.Value == item.StartsAt)
        {
            return item.StartsAt.ToString("MMM d, yyyy HH:mm");
        }

        return item.StartsAt.Date == item.EndsAt.Value.Date
            ? $"{item.StartsAt:MMM d, yyyy HH:mm} - {item.EndsAt:HH:mm}"
            : $"{item.StartsAt:MMM d, yyyy HH:mm} - {item.EndsAt:MMM d, yyyy HH:mm}";
    }

    private static RenderFragment RenderAccordionSection(
        string id,
        string title,
        int count,
        RenderFragment content) => @<div class="accordion-item">
            <h3 class="accordion-header">
                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#@id">
                    @title <span class="badge text-bg-secondary ms-2">@count</span>
                </button>
            </h3>
            <div id="@id" class="accordion-collapse collapse">
                <div class="accordion-body">
                    @if (count == 0)
                    {
                        <div class="text-body-secondary small">No items available.</div>
                    }
                    else
                    {
                        @content
                    }
                </div>
            </div>
        </div>;
}
